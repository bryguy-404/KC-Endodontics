---
import { site } from "../lib/site";
---

<footer id="contact-a" class="bg-foreground text-white">
  <div class="shell grid gap-12 py-16 md:grid-cols-2 lg:grid-cols-[1.15fr_.75fr_.75fr]">
    <div>
      <p class="eyebrow text-white/55">
        {site.name}
      </p>
      <h2 class="font-heading mt-3 max-w-lg text-4xl font-semibold leading-tight sm:text-5xl">
        Ready for a clear next step?
      </h2>
      <a
        href={site.phone.href}
        class="button-inverse mt-7"
        >Call {site.phone.display}</a
      >
    </div>

    <div>
      <p class="text-xs font-bold uppercase tracking-[.16em] text-white/50">Visit the office</p>
      <address class="mt-4 max-w-md not-italic leading-7 text-white/80">
        {site.address.street}<br />{`${site.address.city}, ${site.address.state} ${site.address.zip}`}<br />
      </address>
      <a
        href={site.mapsUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-4 inline-flex font-bold text-white underline underline-offset-4">View directions ↗</a
      >
    </div>

    <nav aria-label="Footer navigation" class="md:col-span-2 lg:col-span-1">
      <p class="text-xs font-bold uppercase tracking-[.16em] text-white/50">Explore</p>
      <ul class="mt-4 grid gap-3 text-sm font-semibold text-white/80">
        <li><a href="#treatments-a" class="hover:text-white">Treatments</a></li>
        <li><a href="#approach-a" class="hover:text-white">Why choose us</a></li>
        <li><a href="#doctor-a" class="hover:text-white">Meet Dr. Moore</a></li>
        <li><a href="#patients-a" class="hover:text-white">Patient information</a></li>
      </ul>
    </nav>
  </div>

  <div class="border-t border-white/15 py-5">
    <div class="shell flex flex-col gap-2 text-xs text-white/50 sm:flex-row sm:items-center sm:justify-between">
      <span>{site.name} · Prairie Village, Kansas</span>
      <span>Compassionate specialty care for your natural teeth.</span>
    </div>
  </div>
</footer>
