---
import PhotoPlaceholder from "./PhotoPlaceholder.astro";

const values = [
  { title: "Compassionate care", body: "A calm, respectful welcome." },
  { title: "Personal guidance", body: "Information centered on your visit." },
  { title: "Professionalism", body: "Clear and focused communication." },
  { title: "Clinical excellence", body: "Specialist attention throughout care." },
];
---

<section id="approach-a" class="py-20 sm:py-28">
  <div class="shell grid items-center gap-12 lg:grid-cols-2">
    <PhotoPlaceholder
      label="calm office detail with soft natural light"
      class="min-h-[390px] rounded-md"
    >
      Image placeholder · Calm office detail
    </PhotoPlaceholder>

    <div>
      <p class="text-xs font-bold uppercase tracking-[.2em] text-secondary">
        Why choose KC Endodontics
      </p>
      <h2 class="font-heading mt-4 text-4xl font-semibold sm:text-5xl">
        Professional by design. Personal by nature.
      </h2>
      <p class="mt-6 text-lg leading-8 text-copy">
        The practice’s approach brings patient comfort, thoughtful communication,
        professionalism, and clinical excellence into one specialist experience.
      </p>
      <div class="mt-8 grid gap-4 sm:grid-cols-2">
        {values.map((value) => (
          <div class="border-l-2 border-primary pl-4">
            <strong>{value.title}</strong>
            <p class="mt-1 text-sm text-copy">{value.body}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
