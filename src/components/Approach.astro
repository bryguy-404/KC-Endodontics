---
import { Image } from "astro:assets";
import office from "../assets/office-detail.jpg";
const values = [
  { title: "Care and commitment", body: "Your safety and comfort are our priority." },
  { title: "Honesty and affordability", body: "Up-front information on cost. Missouri Medicaid accepted for sedation cases." },
  { title: "Comfort", body: "Clear communication can help alleviate dental fear." },
  { title: "Personalized service", body: "We take an interest in you and your oral health needs." },
];
---

<section id="approach-a" class="py-20 sm:py-24">
  <div class="shell grid items-center gap-12 lg:grid-cols-[.94fr_1.06fr] lg:gap-20">
    <figure class="relative min-h-[380px] sm:min-h-[520px]">
      <div aria-hidden="true" class="absolute -bottom-4 -left-4 h-[88%] w-[88%] rounded-lg bg-primary-soft"></div>
      <Image
        src={office}
        format="webp"
        widths={[400, 640, 960, 1200]}
        sizes="(min-width: 1280px) 520px, (min-width: 1024px) 43vw, (min-width: 640px) calc(100vw - 4rem), calc(100vw - 2.5rem)"
        alt="A bright, modern dental treatment room prepared for a patient"
        width="1600"
        height="1067"
        loading="lazy"
        decoding="async"
        class="absolute inset-0 h-full w-full rounded-lg object-cover shadow-[0_24px_60px_rgb(69_66_66/.14)]"
      />
      <figcaption class="absolute bottom-5 left-5 rounded-full bg-background/95 px-4 py-2 text-xs font-bold text-primary-dark shadow-md backdrop-blur sm:bottom-7 sm:left-7">
        A calm, modern care environment
      </figcaption>
    </figure>

    <div>
      <h2 class="font-heading text-4xl font-semibold leading-tight tracking-[-.02em] sm:text-5xl">
        Professional by design. Personal by nature.
      </h2>
      <p class="mt-6 text-lg leading-8 text-copy">
        When it comes to picking an endodontist, we know that you have options.
        Personalized, gentle, comprehensive patient care is our number one priority.
      </p>
      <p class="mt-4 leading-7 text-copy">
        From the front office to the exam room, our practice is made up of
        professionals who take your oral health very seriously. Everything is
        designed around a clean, comfortable, and carefully prepared experience.
      </p>
      <div class="mt-9 grid gap-x-8 gap-y-6 sm:grid-cols-2">
        {values.map((value) => (
          <div>
            <strong class="text-sm">{value.title}</strong>
            <p class="mt-1 text-sm leading-6 text-copy">{value.body}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
