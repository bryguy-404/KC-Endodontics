---
import { site } from "../lib/site";
---

<div class="bg-primary-dark text-white">
  <div
    class="shell flex min-h-9 items-center justify-between gap-4 py-2 text-xs"
  >
    <a href={site.phone.href} class="font-bold tracking-wide">
      <span class="sm:hidden">Need help? Call now</span>
      <span class="hidden sm:inline">Need help today? Call {site.phone.display}</span>
    </a>
    <a
      href={site.mapsUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="text-right text-white/85 hover:text-white hover:underline"
    >
      <span class="sm:hidden">Prairie Village · Directions ↗</span>
      <span class="hidden sm:inline">{site.address.full}</span>
    </a
    >
  </div>
</div>
