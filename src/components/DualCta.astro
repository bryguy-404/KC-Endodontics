---
import { site } from "../lib/site";
---

<section id="patients-a" class="py-16 sm:py-20">
  <div class="shell grid gap-6 lg:grid-cols-2">
    <article class="relative overflow-hidden rounded-md bg-primary-dark p-8 text-white shadow-[0_20px_45px_rgb(63_98_126/.16)] sm:p-10">
      <div aria-hidden="true" class="absolute -right-12 -top-16 h-48 w-48 rounded-full border border-white/10"></div>
      <p class="eyebrow relative text-white/65">
        For new patients
      </p>
      <h2 class="font-heading relative mt-3 max-w-lg text-4xl font-semibold leading-tight">
        Begin with clear information.
      </h2>
      <p class="relative mt-4 max-w-xl leading-7 text-white/80">
        Your first appointment includes a consultation explaining your diagnosis
        and treatment options. Bring your referral slip, recent X-rays, medication
        list, and insurance information when applicable.
      </p>
      <a
        href="/patient-information/first-visit/"
        class="button-inverse relative mt-7"
        >Prepare for your first visit <span aria-hidden="true">→</span></a
      >
    </article>

    <article id="referrals-a" class="rounded-md border border-border bg-surface p-8 sm:p-10">
      <p class="eyebrow text-secondary">
        For referring dentists
      </p>
      <h2 class="font-heading mt-3 max-w-lg text-4xl font-semibold leading-tight">
        A direct specialist connection.
      </h2>
      <p class="mt-4 leading-7 text-copy">
        Referral resources, case-assessment guidance, and treatment-planning
        information are available for dental professionals working with our office.
      </p>
      <a
        href={`${site.legacyUrl}/referring-doctors/`}
        class="button-secondary mt-7 bg-background"
        >Referring dentist resources <span aria-hidden="true">→</span></a
      >
    </article>
  </div>
</section>
