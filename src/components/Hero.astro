---
import { site } from "../lib/site";
---

<section class="relative overflow-hidden bg-background pb-16 pt-12 sm:py-20 lg:py-24">
  <div aria-hidden="true" class="absolute -right-40 -top-56 h-[34rem] w-[34rem] rounded-full bg-primary-soft/70 blur-3xl"></div>
  <div class="shell relative grid items-center gap-11 lg:grid-cols-[1.03fr_.97fr] lg:gap-12">
    <div class="max-w-2xl">
      <p class="eyebrow mb-5 flex items-center gap-3 text-secondary">
        <span aria-hidden="true" class="h-2 w-2 rounded-full bg-secondary"></span>
        Prairie Village endodontic specialist
      </p>
      <h1
        class="font-heading max-w-3xl text-balance text-[clamp(2.25rem,11vw,3rem)] font-semibold leading-[1.02] tracking-[-.025em] text-foreground sm:text-[clamp(3rem,6vw,5rem)]"
      >
        <span class="lg:block">Expert</span>{" "}
        <span class="lg:block">endodontic care,</span>{" "}
        <span class="lg:block">centered on you.</span>
      </h1>
      <p class="mt-7 max-w-xl text-lg leading-8 text-lede sm:text-xl">
        Our expert team, led by respected endodontic specialist Dr. Moore,
        provides the highest standard of professional care in a friendly,
        comfortable environment.
      </p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a
          href={site.phone.href}
          class="button-primary"
          >Call {site.phone.display}<span aria-hidden="true">→</span></a
        >
        <a
          href="#expect-a"
          class="button-secondary"
          >What to expect</a
        >
      </div>
      <ul class="mt-8 flex flex-wrap gap-x-5 gap-y-2 text-sm font-semibold text-fine" aria-label="Practice qualities">
        <li class="flex items-center gap-2"><span aria-hidden="true" class="h-1.5 w-1.5 rounded-full bg-primary"></span>Endodontic specialist</li>
        <li class="flex items-center gap-2"><span aria-hidden="true" class="h-1.5 w-1.5 rounded-full bg-primary"></span>Sedation available</li>
        <li class="flex items-center gap-2"><span aria-hidden="true" class="h-1.5 w-1.5 rounded-full bg-primary"></span>Missouri Medicaid accepted</li>
      </ul>
    </div>

    <figure class="relative min-h-[420px] overflow-hidden rounded-lg bg-primary-soft shadow-[0_30px_70px_rgb(63_98_126/.2)] sm:min-h-[560px]">
      <img
        src="/clinical-consultation.jpg"
        alt="A clinician having a reassuring conversation with a patient in a bright dental office"
        width="1800"
        height="1350"
        loading="eager"
        decoding="async"
        fetchpriority="high"
        class="absolute inset-0 h-full w-full object-cover object-center"
      />
      <div aria-hidden="true" class="absolute inset-0 bg-gradient-to-t from-foreground/30 via-transparent to-transparent"></div>
      <figcaption class="absolute bottom-5 left-5 right-5 flex max-w-sm items-center gap-3 rounded-2xl bg-background/95 p-4 shadow-lg backdrop-blur sm:bottom-7 sm:left-7">
        <span aria-hidden="true" class="grid h-10 w-10 shrink-0 place-items-center rounded-full bg-primary-soft text-xl text-primary-dark">✓</span>
        <span>
          <strong class="block text-sm">Professional care, personally delivered</strong>
          <span class="mt-0.5 block text-xs leading-5 text-copy">Clear guidance from evaluation through follow-up.</span>
        </span>
      </figcaption>
      <div class="absolute right-5 top-5 rounded-full border border-white/50 bg-background/85 px-4 py-2 text-xs font-bold text-primary-dark shadow-sm backdrop-blur sm:right-7 sm:top-7">
        Specialty care · Prairie Village
      </div>
    </figure>
  </div>
</section>
