---
import { site } from "../lib/site";
import PhotoPlaceholder from "./PhotoPlaceholder.astro";
---

<section class="bg-background py-16 sm:py-24">
  <div class="shell grid items-center gap-12 lg:grid-cols-[1.05fr_.95fr]">
    <div>
      <p class="mb-5 text-xs font-bold uppercase tracking-[.2em] text-secondary">
        Prairie Village endodontic specialist
      </p>
      <h1
        class="font-heading max-w-3xl text-5xl font-semibold leading-[1.05] text-foreground sm:text-6xl lg:text-7xl"
      >
        Specialist care that starts with reassurance.
      </h1>
      <p class="mt-7 max-w-xl text-lg leading-8 text-lede">
        When you need endodontic care, clear information and a calm experience
        matter. KC Endodontics provides compassionate, personalized care under
        Dr. Moore.
      </p>
      <div class="mt-9 flex flex-col gap-3 sm:flex-row">
        <a
          href={site.phone.href}
          class="inline-flex min-h-12 items-center justify-center rounded-full bg-primary px-7 py-3 font-bold text-white hover:bg-foreground"
          >Call {site.phone.display}</a
        >
        <a
          href="#patients-a"
          class="inline-flex min-h-12 items-center justify-center rounded-full border border-primary px-7 py-3 font-bold text-primary hover:bg-muted"
          >New Patient Information</a
        >
      </div>
      <p class="mt-7 text-sm leading-6 text-fine">
        Root canal treatment · Endodontic retreatment · Root canal surgery
      </p>
    </div>

    <PhotoPlaceholder
      label="a naturally lit, reassuring conversation between a clinician and patient"
      class="min-h-[430px] rounded-lg sm:min-h-[560px]"
      chipClass="rounded-xl max-w-[260px]"
    >
      Image placeholder<br /><span class="font-normal normal-case tracking-normal"
        >Warm clinician–patient interaction</span
      >
    </PhotoPlaceholder>
  </div>
</section>
