---
import { site, navItems } from "../lib/site";

const pathname = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? pathname === "/" : pathname.startsWith(href);
const dropdownAlignment = (index: number) => {
  if (index === 0) return "nav-dropdown--start";
  if (index >= 3) return "nav-dropdown--end";
  return "nav-dropdown--center";
};
---

<header class="site-header sticky top-0 z-40 border-b border-border/80 bg-background/95 shadow-[0_8px_30px_rgb(69_66_66/.06)] backdrop-blur-xl">
  <div class="shell flex min-h-[4.75rem] items-center justify-between gap-3 py-2 sm:gap-5 xl:py-0">
    <a href="/" aria-label={`${site.name} home`} class="group flex min-w-0 items-center gap-2.5 sm:gap-3">
      <img
        src="/logo.jpg"
        alt=""
        width="320"
        height="222"
        class="h-11 w-16 shrink-0 rounded-md object-cover ring-1 ring-border/70 transition group-hover:ring-primary/50 sm:h-12 sm:w-[69px]"
      />
      <span class="min-w-0 leading-tight">
        <strong class="font-heading block truncate text-base font-semibold tracking-[-.01em] sm:text-xl">KC Endodontics</strong>
        <span class="hidden text-[0.64rem] font-bold uppercase tracking-[.17em] text-label sm:block">
          Endodontic Specialty Care
        </span>
      </span>
    </a>

    <nav aria-label="Primary navigation" class="desktop-nav hidden self-stretch items-center gap-1 text-[0.74rem] font-bold xl:flex 2xl:gap-2 2xl:text-[0.78rem]">
      {navItems.map((item, index) => (
        "children" in item ? (
          <div class="nav-group relative flex h-full items-center py-2">
            <a
              href={item.href}
              aria-current={pathname === item.href ? "page" : undefined}
              class:list={[
                "desktop-nav-link flex min-h-11 items-center gap-1.5 rounded-full px-2.5 transition-colors 2xl:px-3",
                isActive(item.href) && "is-active text-primary-dark",
              ]}
            >
              {item.label}
              <span aria-hidden="true" class="nav-chevron text-[.6rem] text-label">⌄</span>
            </a>
            <div class:list={[
              "nav-dropdown invisible absolute z-50 rounded-md border border-border bg-background p-4 opacity-0 shadow-[0_22px_55px_rgb(69_66_66/.16)]",
              dropdownAlignment(index),
              item.columns === 2
                ? "w-[min(42rem,calc(100vw-2rem))]"
                : "w-72 max-w-[calc(100vw-2rem)]",
            ]}>
              <div class:list={["grid gap-1", item.columns === 2 && "grid-cols-2"]}>
                {item.children.map((child) => (
                  <a
                    href={child.href}
                    aria-current={pathname === child.href ? "page" : undefined}
                    class:list={[
                      "rounded-lg px-3 py-2.5 leading-5 text-copy transition hover:bg-primary-soft hover:text-primary-dark focus-visible:bg-primary-soft",
                      pathname === child.href && "bg-primary-soft text-primary-dark",
                    ]}
                  >
                    {child.label}
                  </a>
                ))}
              </div>
            </div>
          </div>
        ) : (
          <a
            href={item.href}
            aria-current={pathname === item.href ? "page" : undefined}
            class:list={[
              "desktop-nav-link flex min-h-11 items-center rounded-full px-2.5 transition-colors 2xl:px-3",
              isActive(item.href) && "is-active text-primary-dark",
            ]}
          >{item.label}</a>
        )
      ))}
      <a
        href={site.phone.href}
        class="button-primary ml-1 min-h-11 shrink-0 whitespace-nowrap px-4 py-2.5 2xl:px-5"
        >Call The Office</a
      >
    </nav>

    <button
      id="navButtonA"
      type="button"
      aria-controls="mobileNavA"
      aria-expanded="false"
      aria-label="Open navigation"
      class="nav-trigger inline-flex h-12 w-12 shrink-0 flex-col items-center justify-center gap-1 rounded-full border border-border bg-surface text-foreground shadow-[0_8px_24px_rgb(69_66_66/.08)] transition hover:border-primary/50 hover:bg-primary-soft focus-visible:border-primary xl:hidden"
    >
      <span aria-hidden="true"></span>
      <span aria-hidden="true"></span>
      <span aria-hidden="true"></span>
    </button>
  </div>

  <nav
    id="mobileNavA"
    aria-label="Mobile navigation"
    class="mobile-nav-panel hidden max-h-[calc(100dvh-7rem)] overflow-y-auto overscroll-contain border-t border-border bg-background/98 py-3 shadow-[0_22px_50px_rgb(69_66_66/.14)] xl:hidden"
  >
    <div class="shell flex flex-col pb-4 font-semibold">
      <p class="eyebrow px-3 pb-2 pt-1 text-primary-dark">Explore KC Endodontics</p>
      {navItems.map((item) => (
        "children" in item ? (
          <details class:list={["mobile-nav-group border-b border-border/70", isActive(item.href) && "mobile-nav-current"]} open={isActive(item.href)}>
            <summary class="mobile-nav-summary flex min-h-[3.25rem] cursor-pointer list-none items-center justify-between gap-4 rounded-lg px-3 py-3.5 transition hover:bg-surface">
              <span>{item.label}</span>
              <span aria-hidden="true" class="mobile-nav-plus text-xl font-normal text-primary-dark">+</span>
            </summary>
            <div class="grid gap-1 px-2 pb-4 text-sm font-semibold text-copy sm:grid-cols-2">
              {item.children.map((child) => (
                <a
                  href={child.href}
                  aria-current={pathname === child.href ? "page" : undefined}
                  class:list={[
                    "flex min-h-11 items-center rounded-lg px-3 py-2.5 transition hover:bg-primary-soft hover:text-primary-dark",
                    pathname === child.href && "bg-primary-soft text-primary-dark",
                  ]}
                >{child.label}</a>
              ))}
            </div>
          </details>
        ) : (
          <a
            href={item.href}
            aria-current={pathname === item.href ? "page" : undefined}
            class:list={[
              "flex min-h-[3.25rem] items-center rounded-lg border-b border-border/70 px-3 py-3.5 transition hover:bg-surface",
              isActive(item.href) && "text-primary-dark",
            ]}
          >{item.label}</a>
        )
      ))}
      <div class="mt-5 grid gap-3 sm:grid-cols-2">
        <a href={site.phone.href} class="button-primary w-full">Call {site.phone.display}</a>
        <a href={site.mapsUrl} target="_blank" rel="noopener noreferrer" class="button-secondary w-full">Get Directions ↗</a>
      </div>
    </div>
  </nav>
</header>

<script>
  document.querySelectorAll<HTMLElement>(".nav-group").forEach((group) => {
    let closeTimer: ReturnType<typeof setTimeout> | undefined;

    const openDropdown = () => {
      if (closeTimer) window.clearTimeout(closeTimer);
      group.classList.add("is-open");
    };

    const closeDropdown = () => {
      if (closeTimer) window.clearTimeout(closeTimer);
      group.classList.remove("is-open");
    };

    const scheduleClose = () => {
      if (closeTimer) window.clearTimeout(closeTimer);
      closeTimer = window.setTimeout(closeDropdown, 240);
    };

    group.addEventListener("pointerenter", openDropdown);
    group.addEventListener("pointerleave", scheduleClose);
    group.addEventListener("focusin", openDropdown);
    group.addEventListener("focusout", (event) => {
      if (!group.contains(event.relatedTarget as Node | null)) scheduleClose();
    });
    group.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        closeDropdown();
        group.querySelector<HTMLElement>("a")?.focus();
      }
    });
  });

  const button = document.getElementById("navButtonA");
  const panel = document.getElementById("mobileNavA");

  if (button && panel) {
    const header = button.closest(".site-header");

    const setOpen = (open: boolean) => {
      panel.classList.toggle("hidden", !open);
      button.classList.toggle("is-open", open);
      header?.classList.toggle("is-menu-open", open);
      document.documentElement.classList.toggle("nav-is-open", open);
      button.setAttribute("aria-expanded", String(open));
      button.setAttribute("aria-label", open ? "Close navigation" : "Open navigation");
    };

    button.addEventListener("click", () =>
      setOpen(panel.classList.contains("hidden")),
    );

    panel
      .querySelectorAll("a")
      .forEach((link) => link.addEventListener("click", () => setOpen(false)));

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && !panel.classList.contains("hidden")) {
        setOpen(false);
        button.focus();
      }
    });

    window.matchMedia("(min-width: 1280px)").addEventListener("change", (event) => {
      if (event.matches) setOpen(false);
    });
  }
</script>
