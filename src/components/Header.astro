---
import { site, navItems } from "../lib/site";

const pathname = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? pathname === "/" : pathname.startsWith(href);
---

<header class="sticky top-0 z-40 border-b border-border/80 bg-background/90 backdrop-blur-xl">
  <div class="shell flex min-h-[4.75rem] items-center justify-between gap-5">
    <a href="/" aria-label={`${site.name} home`} class="flex items-center gap-3">
      <img
        src="/logo.jpg"
        alt=""
        width="320"
        height="222"
        class="h-12 w-[69px] rounded-sm object-cover"
      />
      <span class="leading-tight">
        <strong class="font-heading block text-lg font-semibold sm:text-xl">KC Endodontics</strong>
        <span class="hidden text-[0.64rem] font-bold uppercase tracking-[.17em] text-label sm:block">
          Endodontic specialty care
        </span>
      </span>
    </a>

    <nav aria-label="Primary navigation" class="hidden items-center gap-4 text-[0.78rem] font-semibold xl:flex 2xl:gap-6">
      {navItems.map((item) => (
        "children" in item ? (
          <div class="nav-group relative py-5">
            <a
              href={item.href}
              aria-current={pathname === item.href ? "page" : undefined}
              class:list={[
                "flex items-center gap-1.5 transition-colors hover:text-accent",
                isActive(item.href) && "text-primary-dark",
              ]}
            >
              {item.label}
              <span aria-hidden="true" class="text-[.6rem] text-label">⌄</span>
            </a>
            <div class:list={[
              "nav-dropdown invisible absolute left-1/2 top-[calc(100%-1px)] z-50 -translate-x-1/2 translate-y-2 rounded-md border border-border bg-background p-4 opacity-0 shadow-[0_22px_55px_rgb(69_66_66/.16)] transition",
              item.columns === 2 ? "w-[42rem]" : "w-72",
            ]}>
              <div class:list={["grid gap-1", item.columns === 2 && "grid-cols-2"]}>
                {item.children.map((child) => (
                  <a
                    href={child.href}
                    aria-current={pathname === child.href ? "page" : undefined}
                    class:list={[
                      "rounded-lg px-3 py-2.5 leading-5 text-copy transition hover:bg-primary-soft hover:text-primary-dark focus-visible:bg-primary-soft",
                      pathname === child.href && "bg-primary-soft text-primary-dark",
                    ]}
                  >
                    {child.label}
                  </a>
                ))}
              </div>
            </div>
          </div>
        ) : (
          <a
            href={item.href}
            aria-current={pathname === item.href ? "page" : undefined}
            class:list={["transition-colors hover:text-accent", isActive(item.href) && "text-primary-dark"]}
          >{item.label}</a>
        )
      ))}
      <a
        href={site.phone.href}
        class="button-primary min-h-11 shrink-0 px-5 py-2.5"
        >Call the office</a
      >
    </nav>

    <button
      id="navButtonA"
      type="button"
      aria-controls="mobileNavA"
      aria-expanded="false"
      aria-label="Open navigation"
      class="nav-trigger h-11 w-11 rounded-full border border-border bg-background text-foreground xl:hidden"
    >
      <span aria-hidden="true"></span>
      <span aria-hidden="true"></span>
      <span aria-hidden="true"></span>
    </button>
  </div>

  <nav
    id="mobileNavA"
    aria-label="Mobile navigation"
    class="hidden border-t border-border bg-background px-5 py-5 shadow-[0_18px_40px_rgb(69_66_66/.12)] xl:hidden"
  >
    <div class="mx-auto flex max-w-7xl flex-col font-semibold">
      {navItems.map((item) => (
        "children" in item ? (
          <details class="mobile-nav-group border-b border-border/70" open={isActive(item.href)}>
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-3.5">
              <span>{item.label}</span>
              <span aria-hidden="true" class="mobile-nav-plus text-xl font-normal text-primary-dark">+</span>
            </summary>
            <div class="grid gap-1 pb-4 pl-3 text-sm font-semibold text-copy sm:grid-cols-2">
              {item.children.map((child) => (
                <a
                  href={child.href}
                  aria-current={pathname === child.href ? "page" : undefined}
                  class:list={[
                    "rounded-lg px-3 py-2.5 hover:bg-primary-soft hover:text-primary-dark",
                    pathname === child.href && "bg-primary-soft text-primary-dark",
                  ]}
                >{child.label}</a>
              ))}
            </div>
          </details>
        ) : (
          <a
            href={item.href}
            aria-current={pathname === item.href ? "page" : undefined}
            class:list={[
              "border-b border-border/70 py-3.5",
              isActive(item.href) && "text-primary-dark",
            ]}
          >{item.label}</a>
        )
      ))}
      <a
        href={site.phone.href}
        class="button-primary mt-5 w-full"
        >Call {site.phone.display}</a
      >
    </div>
  </nav>
</header>

<script>
  const button = document.getElementById("navButtonA");
  const panel = document.getElementById("mobileNavA");

  if (button && panel) {
    const setOpen = (open: boolean) => {
      panel.classList.toggle("hidden", !open);
      button.classList.toggle("is-open", open);
      button.setAttribute("aria-expanded", String(open));
      button.setAttribute("aria-label", open ? "Close navigation" : "Open navigation");
    };

    button.addEventListener("click", () =>
      setOpen(panel.classList.contains("hidden")),
    );

    panel
      .querySelectorAll("a")
      .forEach((link) => link.addEventListener("click", () => setOpen(false)));

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && !panel.classList.contains("hidden")) {
        setOpen(false);
        button.focus();
      }
    });

    window.matchMedia("(min-width: 1280px)").addEventListener("change", (event) => {
      if (event.matches) setOpen(false);
    });
  }
</script>
