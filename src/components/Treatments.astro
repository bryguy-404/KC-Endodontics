---
import { site } from "../lib/site";

const treatments = [
  {
    ordinal: "01",
    short: "Save the natural tooth",
    title: "Root canal treatment",
    body: "Specialist care for a tooth that needs treatment within the root canal system.",
    linkLabel: "Ask the office about treatment →",
  },
  {
    ordinal: "02",
    short: "Renew previous care",
    title: "Endodontic retreatment",
    body: "A focused next step when a previously treated tooth needs renewed endodontic attention.",
    linkLabel: "Discuss retreatment →",
  },
  {
    ordinal: "03",
    short: "Resolve complex concerns",
    title: "Root canal surgery",
    body: "Specialist guidance when root canal surgery, also called apicoectomy, is being considered.",
    linkLabel: "Ask about surgical care →",
  },
];
---

<section id="treatments-a" class="bg-surface py-20 sm:py-24">
  <div class="shell">
    <div class="grid gap-7 lg:grid-cols-[.72fr_1.28fr] lg:items-end">
      <div>
        <p class="eyebrow text-secondary">Endodontic care</p>
        <h2 class="font-heading mt-4 max-w-xl text-4xl font-semibold leading-tight tracking-[-.02em] sm:text-5xl">
          A focused path for your next step.
        </h2>
      </div>
      <p class="max-w-xl text-lg leading-8 text-copy lg:justify-self-end">
        Every visit begins with a careful evaluation and a straightforward
        explanation of what comes next.
      </p>
    </div>

    <div class="mt-12 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
      {treatments.map((treatment) => (
        <article class="service-card flex min-h-[21rem] flex-col rounded-md border border-border/90 bg-background p-7 shadow-[0_12px_30px_rgb(69_66_66/.05)] sm:p-8">
          <div class="flex items-center justify-between gap-4">
            <span class="grid h-11 w-11 place-items-center rounded-full bg-secondary-soft text-sm font-bold text-secondary">{treatment.ordinal}</span>
            <span class="text-right text-xs font-bold uppercase tracking-[.12em] text-label">{treatment.short}</span>
          </div>
          <h3 class="font-heading mt-8 text-3xl font-semibold leading-tight">{treatment.title}</h3>
          <p class="mt-4 leading-7 text-copy">{treatment.body}</p>
          <a
            href={site.phone.href}
            class="mt-auto inline-flex items-center gap-2 pt-7 font-bold text-accent hover:underline"
          >
            {treatment.linkLabel}
          </a>
        </article>
      ))}
    </div>
  </div>
</section>
