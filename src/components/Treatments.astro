---
const treatments = [
  {
    title: "Root canal treatment",
    body: "This treatment can save your natural tooth and prevent the need for an implant or bridge.",
    href: "/procedures/root-canal/",
    linkLabel: "Explore root canal treatment →",
  },
  {
    title: "Endodontic retreatment",
    body: "A previously treated tooth may fail to heal or pain may continue months or years after treatment.",
    href: "/procedures/endodontic-retreatment/",
    linkLabel: "Explore retreatment →",
  },
  {
    title: "Endodontic surgery",
    body: "Surgery can help locate fractures or hidden canals and treat damaged root surfaces or surrounding bone.",
    href: "/procedures/apicoectomy/",
    linkLabel: "Explore endodontic surgery →",
  },
];

const focusedCare = [
  {
    title: "Cracked teeth",
    body: "Specialist evaluation for pain when chewing, temperature sensitivity, or a suspected fracture.",
    href: "/procedures/cracked-teeth/",
  },
  {
    title: "Traumatic injuries",
    body: "Focused care for teeth that are chipped, displaced, knocked out, or affected by dental trauma.",
    href: "/procedures/traumatic-injuries/",
  },
  {
    title: "Sedation dentistry",
    body: "IV sedation administered and monitored by a board-eligible anesthesiologist. Nitrous oxide for a lighter touch. All patients welcome, Missouri Medicaid accepted for sedation cases.",
    href: "/procedures/sedation-dentistry/",
  },
];
---

<section id="treatments-a" class="bg-surface py-20 sm:py-24">
  <div class="shell">
    <div class="grid gap-7 lg:grid-cols-[.72fr_1.28fr] lg:items-end">
      <div>
        <h2 class="font-heading max-w-xl text-4xl font-semibold leading-tight tracking-[-.02em] sm:text-5xl">
          A focused path for your next step.
        </h2>
      </div>
      <p class="max-w-xl text-lg leading-8 text-copy lg:justify-self-end">
        Every visit begins with a careful evaluation and a straightforward
        explanation of what comes next.
      </p>
    </div>

    <article class="mt-12 grid gap-6 rounded-md border border-border/90 bg-background p-7 sm:p-9 lg:grid-cols-[.85fr_1.15fr] lg:items-center lg:gap-12">
      <h3 class="font-heading text-4xl font-semibold leading-tight">{treatments[0].title}</h3>
      <div>
        <p class="text-lg leading-8 text-copy">{treatments[0].body}</p>
        <a href={treatments[0].href} class="mt-5 inline-flex font-bold text-accent hover:underline">{treatments[0].linkLabel}</a>
      </div>
    </article>

    <div class="mt-5 grid gap-5 md:grid-cols-2">
      {[...treatments.slice(1), ...focusedCare].map((item) => (
        <a
          href={item.href}
          class:list={["group flex items-start justify-between gap-6 transition hover:border-primary/50", item.href === "/procedures/sedation-dentistry/" ? "rounded-md border border-border/90 bg-background p-6 sm:p-7 md:col-span-2" : "border-b border-border py-6"]}
        >
          <span>
            <strong class="font-heading block text-2xl font-semibold">{item.title}</strong>
            <span class="mt-2 block leading-7 text-copy">{item.body}</span>
          </span>
          <span aria-hidden="true" class="mt-1 text-xl text-accent transition-transform group-hover:translate-x-1">→</span>
        </a>
      ))}
    </div>
  </div>
</section>
