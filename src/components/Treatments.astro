---
import { site } from "../lib/site";

const treatments = [
  {
    ordinal: "01",
    short: "Save the natural tooth",
    title: "Root canal treatment",
    body: "This treatment can save your natural tooth and prevent the need for an implant or bridge.",
    href: `${site.legacyUrl}/procedures/root-canal/`,
    linkLabel: "Explore root canal treatment →",
  },
  {
    ordinal: "02",
    short: "Renew previous care",
    title: "Endodontic retreatment",
    body: "A previously treated tooth may fail to heal or pain may continue months or years after treatment.",
    href: `${site.legacyUrl}/procedures/endodontic-retreatment/`,
    linkLabel: "Explore retreatment →",
  },
  {
    ordinal: "03",
    short: "Resolve complex concerns",
    title: "Endodontic surgery",
    body: "Surgery can help locate fractures or hidden canals and treat damaged root surfaces or surrounding bone.",
    href: `${site.legacyUrl}/procedures/apicoectomy/`,
    linkLabel: "Explore endodontic surgery →",
  },
];

const focusedCare = [
  {
    title: "Cracked teeth",
    body: "Specialist evaluation for pain when chewing, temperature sensitivity, or a suspected fracture.",
    href: `${site.legacyUrl}/procedures/cracked-teeth/`,
  },
  {
    title: "Traumatic injuries",
    body: "Focused care for teeth that are chipped, displaced, knocked out, or affected by dental trauma.",
    href: `${site.legacyUrl}/procedures/traumatic-injuries/`,
  },
];
---

<section id="treatments-a" class="bg-surface py-20 sm:py-24">
  <div class="shell">
    <div class="grid gap-7 lg:grid-cols-[.72fr_1.28fr] lg:items-end">
      <div>
        <p class="eyebrow text-secondary">Endodontic care</p>
        <h2 class="font-heading mt-4 max-w-xl text-4xl font-semibold leading-tight tracking-[-.02em] sm:text-5xl">
          A focused path for your next step.
        </h2>
      </div>
      <p class="max-w-xl text-lg leading-8 text-copy lg:justify-self-end">
        Every visit begins with a careful evaluation and a straightforward
        explanation of what comes next.
      </p>
    </div>

    <div class="mt-12 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
      {treatments.map((treatment) => (
        <article class="service-card flex min-h-[21rem] flex-col rounded-md border border-border/90 bg-background p-7 shadow-[0_12px_30px_rgb(69_66_66/.05)] sm:p-8">
          <div class="flex items-center justify-between gap-4">
            <span class="grid h-11 w-11 place-items-center rounded-full bg-secondary-soft text-sm font-bold text-secondary">{treatment.ordinal}</span>
            <span class="text-right text-xs font-bold uppercase tracking-[.12em] text-label">{treatment.short}</span>
          </div>
          <h3 class="font-heading mt-8 text-3xl font-semibold leading-tight">{treatment.title}</h3>
          <p class="mt-4 leading-7 text-copy">{treatment.body}</p>
          <a
            href={treatment.href}
            class="mt-auto inline-flex items-center gap-2 pt-7 font-bold text-accent hover:underline"
          >
            {treatment.linkLabel}
          </a>
        </article>
      ))}
    </div>

    <div class="mt-5 grid gap-5 md:grid-cols-2">
      {focusedCare.map((item) => (
        <a
          href={item.href}
          class="group flex items-start justify-between gap-6 rounded-md border border-border/90 bg-background p-6 transition hover:border-primary/50 hover:shadow-[0_16px_36px_rgb(69_66_66/.08)] sm:p-7"
        >
          <span>
            <strong class="font-heading block text-2xl font-semibold">{item.title}</strong>
            <span class="mt-2 block leading-7 text-copy">{item.body}</span>
          </span>
          <span aria-hidden="true" class="mt-1 text-xl text-accent transition-transform group-hover:translate-x-1">→</span>
        </a>
      ))}
    </div>
  </div>
</section>
