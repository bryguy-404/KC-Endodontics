---
import { site } from "../lib/site";

const treatments = [
  {
    ordinal: "01",
    title: "Root canal treatment",
    body: "Specialist care for a tooth that needs treatment within the root canal system.",
    linkLabel: "Ask the office about treatment →",
  },
  {
    ordinal: "02",
    title: "Endodontic retreatment",
    body: "A focused next step when a previously treated tooth needs renewed endodontic attention.",
    linkLabel: "Discuss retreatment →",
  },
  {
    ordinal: "03",
    title: "Root canal surgery",
    body: "Specialist guidance when root canal surgery, also called apicoectomy, is being considered.",
    linkLabel: "Ask about surgical care →",
  },
];
---

<section id="treatments-a" class="bg-muted py-20 sm:py-28">
  <div class="shell">
    <div class="mx-auto max-w-3xl text-center">
      <p class="text-xs font-bold uppercase tracking-[.2em] text-secondary">
        Endodontic care
      </p>
      <h2 class="font-heading mt-4 text-4xl font-semibold sm:text-5xl">
        A focused path for your next step.
      </h2>
      <p class="mt-5 leading-7 text-copy">
        Explore the practice’s core services, then call the office for guidance
        specific to your visit.
      </p>
    </div>

    <div class="mt-12 grid gap-5 lg:grid-cols-3">
      {treatments.map((treatment) => (
        <article class="rounded-md border border-border bg-background p-7 shadow-sm">
          <span class="text-sm font-bold text-secondary">{treatment.ordinal}</span>
          <h3 class="font-heading mt-7 text-3xl font-semibold">{treatment.title}</h3>
          <p class="mt-4 leading-7 text-copy">{treatment.body}</p>
          <a
            href={site.phone.href}
            class="mt-7 inline-flex font-bold text-accent hover:underline"
          >
            {treatment.linkLabel}
          </a>
        </article>
      ))}
    </div>
  </div>
</section>
