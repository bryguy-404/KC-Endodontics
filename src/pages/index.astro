---
import Layout from "../layouts/Layout.astro";
import UtilityBar from "../components/UtilityBar.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import StatBand from "../components/StatBand.astro";
import Treatments from "../components/Treatments.astro";
import Approach from "../components/Approach.astro";
import QuoteBand from "../components/QuoteBand.astro";
import Doctor from "../components/Doctor.astro";
import DualCta from "../components/DualCta.astro";
import Footer from "../components/Footer.astro";
---

<Layout>
  <UtilityBar />
  <Header />

  <main id="main-a">
    <Hero />
    <StatBand />
    <Treatments />
    <Approach />
    <QuoteBand />
    <Doctor />
    <DualCta />
  </main>

  <Footer />
</Layout>
