---
import { getCollection, render, type CollectionEntry } from "astro:content";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import UtilityBar from "../components/UtilityBar.astro";
import Layout from "../layouts/Layout.astro";
import { site } from "../lib/site";

export async function getStaticPaths() {
  const pages = await getCollection("pages");

  return pages.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<"pages">;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, description, eyebrow, summary, template, urgent, urgentText, related } = entry.data;
const isLanding = template === "landing";
const slug = entry.data.slug;
const isRootCanalChild = entry.data.slug.startsWith("procedures/root-canal/");
const isPatientPage = slug === "patient-information" || slug.startsWith("patient-information/");
const isInstructionPage = slug === "instructions" || slug.startsWith("instructions/");

const section = isPatientPage
  ? { label: "Patient information", href: "/patient-information/", root: "patient-information" }
  : isInstructionPage
    ? { label: "Instructions", href: "/instructions/", root: "instructions" }
    : slug === "procedures" || slug.startsWith("procedures/")
      ? { label: "Treatments", href: "/procedures/", root: "procedures" }
      : null;

const breadcrumbs = [
  { label: "Home", href: "/" },
  ...(isLanding
    ? [{ label: "Contact us", href: `${site.legacyUrl}/contact-us/` }]
    : section && slug !== section.root
      ? [{ label: section.label, href: section.href }]
      : []),
  ...(isRootCanalChild
    ? [{ label: "Root canal treatment", href: "/procedures/root-canal/" }]
    : []),
  { label: title },
];

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      name: title,
      description,
      url: new URL(`/${entry.data.slug}/`, site.url).href,
      isPartOf: {
        "@type": "WebSite",
        name: site.name,
        url: site.url,
      },
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: breadcrumbs.map((crumb, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: crumb.label,
        ...(crumb.href ? { item: new URL(crumb.href, site.url).href } : {}),
      })),
    },
  ],
};
---

<Layout title={`${title} | ${site.name}`} description={description} structuredData={structuredData}>
  <UtilityBar />
  <Header />

  <main id="main-a">
    <section class="content-hero relative overflow-hidden border-b border-border bg-surface">
      <div class="pointer-events-none absolute -right-20 -top-20 h-72 w-72 rounded-full border border-primary/15 sm:h-96 sm:w-96"></div>
      <div class="pointer-events-none absolute right-10 top-10 h-48 w-48 rounded-full border border-secondary/10 sm:h-64 sm:w-64"></div>

      <div class="shell relative py-12 sm:py-16 lg:py-20">
        <nav aria-label="Breadcrumb" class="mb-10 overflow-x-auto">
          <ol class="flex min-w-max items-center gap-2 text-xs font-bold uppercase tracking-[.12em] text-label">
            {breadcrumbs.map((crumb, index) => (
              <li class="flex items-center gap-2">
                {crumb.href ? <a href={crumb.href} class="hover:text-accent">{crumb.label}</a> : <span aria-current="page">{crumb.label}</span>}
                {index < breadcrumbs.length - 1 && <span aria-hidden="true" class="text-border">/</span>}
              </li>
            ))}
          </ol>
        </nav>

        <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_20rem] lg:items-end">
          <div>
            <p class="eyebrow text-secondary">{eyebrow}</p>
            <h1 class="font-heading mt-4 max-w-4xl text-5xl font-semibold leading-[1.04] tracking-[-.035em] sm:text-6xl lg:text-7xl">
              {title}
            </h1>
            <p class="mt-6 max-w-3xl text-lg leading-8 text-lede sm:text-xl sm:leading-9">{summary}</p>
          </div>

          <div class="rounded-md bg-primary-dark p-6 text-white shadow-[0_20px_50px_rgb(63_98_126/.2)] sm:p-7">
            <p class="text-xs font-bold uppercase tracking-[.16em] text-white/60">Talk with our team</p>
            <p class="font-heading mt-3 text-2xl font-semibold leading-snug">A calm, clear next step starts with a conversation.</p>
            <a href={site.phone.href} class="button-inverse mt-6 w-full">Call {site.phone.display}</a>
          </div>
        </div>
      </div>
    </section>

    {urgent && (
      <aside class="border-b border-secondary/15 bg-secondary-soft" aria-label="Urgent care note">
        <div class="shell flex flex-col gap-3 py-5 sm:flex-row sm:items-center sm:justify-between">
          <p class="font-semibold text-foreground">{urgentText ?? "Call the office if your symptoms are urgent or getting worse."}</p>
          <a href={site.phone.href} class="font-bold text-secondary underline underline-offset-4">Call now →</a>
        </div>
      </aside>
    )}

    <section class="bg-background py-16 sm:py-20 lg:py-24">
      <div class="shell grid gap-14 lg:grid-cols-[minmax(0,1fr)_19rem] lg:gap-20">
        <article class="prose-content max-w-3xl">
          <Content />
        </article>

        <aside class="lg:order-last">
          <div class="space-y-5 lg:sticky lg:top-32">
            <div class="rounded-md border border-border bg-surface p-6">
              <p class="eyebrow text-primary-dark">{isPatientPage ? "Patient resources" : isInstructionPage ? "Visit guidance" : "Specialist care"}</p>
              <h2 class="font-heading mt-3 text-2xl font-semibold leading-tight">
                {isPatientPage ? "Prepared, informed, and never rushed." : isInstructionPage ? "Keep your care plan close." : "Focused on saving natural teeth."}
              </h2>
              <p class="mt-3 text-sm leading-6 text-copy">
                {isInstructionPage
                  ? "These pages support—not replace—the instructions provided for your individual treatment. Call whenever something feels unclear."
                  : "Dr. Brian Moore provides endodontic care in Prairie Village with clear explanations and close coordination with your restorative dentist."}
              </p>
            </div>
            {!isLanding && section && slug !== section.root && (
              <a href={section.href} class="group flex items-center justify-between rounded-md border border-border bg-background p-5 font-bold text-primary-dark hover:border-primary/50">
                <span>{section.label === "Treatments" ? "View all treatments" : `View all ${section.label.toLowerCase()}`}</span>
                <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span>
              </a>
            )}
            <div class="rounded-md border border-border bg-background p-6">
              <p class="text-xs font-bold uppercase tracking-[.14em] text-label">Office</p>
              <p class="mt-3 text-sm leading-6 text-copy">{site.address.street}<br />{site.address.city}, {site.address.state} {site.address.zip}</p>
              <a href={site.mapsUrl} target="_blank" rel="noopener noreferrer" class="mt-3 inline-flex text-sm font-bold text-accent underline underline-offset-4">Get directions ↗</a>
            </div>
          </div>
        </aside>
      </div>
    </section>

    {related.length > 0 && (
      <section class="border-y border-border bg-surface py-16 sm:py-20">
        <div class="shell">
          <div class="max-w-2xl">
            <p class="eyebrow text-secondary">Keep exploring</p>
            <h2 class="font-heading mt-3 text-4xl font-semibold tracking-[-.02em] sm:text-5xl">Related care and guidance.</h2>
          </div>
          <div class="mt-10 grid gap-5 md:grid-cols-2 xl:grid-cols-3">
            {related.map((item) => (
              <a href={item.href} class="service-card group flex min-h-56 flex-col rounded-md border border-border bg-background p-6 sm:p-7">
                <h3 class="font-heading text-2xl font-semibold leading-tight">{item.title}</h3>
                <p class="mt-3 leading-7 text-copy">{item.description}</p>
                <span class="mt-auto pt-6 font-bold text-accent">Learn more <span aria-hidden="true" class="inline-block transition-transform group-hover:translate-x-1">→</span></span>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

    <section class="bg-primary-dark py-14 text-white sm:py-16">
      <div class="shell flex flex-col gap-8 lg:flex-row lg:items-center lg:justify-between">
        <div>
          <p class="eyebrow text-white/55">KC Endodontics</p>
          <h2 class="font-heading mt-3 max-w-3xl text-4xl font-semibold leading-tight sm:text-5xl">
            {isPatientPage || isInstructionPage ? "Questions before or after your visit?" : "Questions about your tooth or treatment?"}
          </h2>
        </div>
        <a href={site.phone.href} class="button-inverse shrink-0">Call {site.phone.display}</a>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
